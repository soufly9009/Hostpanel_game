# SQLite local (libsql). Pour Turso : libsql://<db>.turso.io + DATABASE_AUTH_TOKEN
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# Jeton (>= 16 car.) pour POST /api/admin/db/deploy
ADMIN_TOKEN=

SITE_NAME=GameHost

# Proxmox VE (VPS)
PROXMOX_URL=https://pve.exemple.com:8006
PROXMOX_TOKEN_ID=root@pam!hosting
PROXMOX_TOKEN_SECRET=
PROXMOX_INSECURE_TLS=false

# Accès SSH à l'hôte Proxmox (pct exec : autoriser root en SSH dans les LXC)
# PROXMOX_SSH_PASSWORD=
# PROXMOX_SSH_HOST=

# Plesk (sites web)
# PLESK_URL=https://plesk.exemple.com:8443
# PLESK_API_KEY=
# PLESK_INSECURE_TLS=false
# PLESK_SERVICE_PLAN=Default Domain
# PLESK_SITE_LIMIT=3

# Snapshots automatiques conservés par VPS
# SNAPSHOT_AUTO_KEEP=3

# Supervision : webhook Discord entrant (Paramètres du salon > Intégrations > Webhooks).
# Absent ou vide = notifications Discord désactivées. Ne jamais commiter cette URL.
DISCORD_LOG_WEBHOOK_URL=
# URL publique https du panel : ajoute un lien dans les messages (facultatif).
# PANEL_PUBLIC_URL=https://panel.exemple.com

# Assistant IA des tickets : OpenRouter (modèles gratuits « :free » uniquement).
# Clé à créer sur openrouter.ai ; absente = pas de réponses IA.
OPENROUTER_API_KEY=
# Modèle gratuit préféré (facultatif), ex. meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_MODEL=

# Clé maîtresse de l API REST /api/v1 (format sou_..., 24+ caractères après le préfixe).
# Préférer des clés créées dans /admin/api (révocables, portées limitées).
# SOU_API_KEY=
